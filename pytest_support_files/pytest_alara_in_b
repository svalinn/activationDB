geometry rectangular

volume
     10    zone_1
end

mat_loading
    zone_1    mix_1
end

mixture mix_1
    element b 1 1.0
end

material_lib matlib.sample
element_lib elelib.std
data_library alaralib fendl2bin

output zone
        units Bq cm3 s
	specific_activity
end

#     flux name    fluxin file   norm   shift   unused
flux  my_flux       fluxin2 1     0      default

schedule    sch_1
    1 y my_flux ph_1 0  s
end

pulsehistory  ph_1
    10    5.0    s
end

#other parameters
truncation 1
dump_file pytest_alara_dump.file
